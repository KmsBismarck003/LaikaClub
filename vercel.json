{
  "framework": "create-react-app",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://laikaclub-yxdb1q.northcentralus.cloudapp.azure.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://laikaclub-yxdb1q.northcentralus.cloudapp.azure.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
