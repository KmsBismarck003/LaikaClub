# Configuración personalizada de variables para Laika Club en Azure
# Región con latencia mínima a México y sin restricciones de cuota estudiantil

location            = "southcentralus"
resource_group_name = "rg-laikaclub"
vm_size             = "Standard_B2ps_v2" # Ampere Altra ARM64 2 vCPU, 8 GB RAM (~$28.03 USD/mes)
os_image_sku        = "22_04-lts-arm64"
admin_username      = "azureuser"
dns_prefix          = "laikaclub"
allowed_ssh_ip      = "*"
notification_email  = "al222310440@gmail.com"
budget_amount       = 85.0
